#% if netdev_enabled %#
---
# The netdev-mcp reader's credentials. jg-base mounts the whole Secret, not a
# subPath, at /etc/netdev-mcp/reader on that container only: ca.crt is what
# TLS to the console is verified against (there is no switch to skip it);
# reader is the View Only local account the server signs in as -- jg-base's
# UNIFI_READER_FILE, user on the first line, password on the second, the same
# shape as unifi-operator. Not an API key: the console has none that is
# read-only (jgct#261).
apiVersion: v1
kind: Secret
metadata:
  name: unifi-reader
  namespace: claudecode
stringData:
  ca.crt: |
    #% filter indent(width=4, first=False) %#
    #{ unifi_ca_cert | trim }#
    #% endfilter %#
  reader: |
    #{ unifi_reader_user | trim }#
    #{ unifi_reader_password | trim }#
#% endif %#
