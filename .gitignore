# Secrets — never commit
age.key
github-deploy.key
github-deploy.key.pub
github-push-token.txt
cloudflare-tunnel.json
auth0.json

# Generated by task configure — gitignore, commit only what Flux needs
.sops.yaml
/bootstrap/
/talos/
kubeconfig
trello-notifier.yaml
.venv/
.claude/

# Per-cluster config (non-sensitive but not part of template)
cluster.yaml
nodes.yaml
__pycache__/

# Built customer print sheets — regenerate with `task print-zero-it`.
# The stamp in the filename is derived from the source, so a build is never
# authoritative; the Markdown is.
dist/
